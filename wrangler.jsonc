{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "eclipsseinorbit",
  "compatibility_date": "2026-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  "assets": {
    "directory": "dist/client",
  },
  // Límite de peticiones para crear sesiones de Checkout (SEGURIDAD.md, hallazgo A1).
  // No cubre /api/stripe-webhook: CLAUDE.md §4 prohíbe limitar el webhook.
  // El contador es local por ubicación de Cloudflare y eventualmente consistente
  // entre ubicaciones, no un cerrojo global exacto. Periodo fijo a 60 s (únicos
  // valores admitidos por el binding: 10 o 60).
  "ratelimits": [
    {
      "name": "CHECKOUT_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 20,
        "period": 60,
      },
    },
  ],
  "observability": {
    "enabled": true,
  },
  "env": {
    // Entorno de preproducción: Worker independiente, sin rutas ni dominio propio.
    // Los bindings no se heredan entre entornos, así que el rate limiter se
    // repite aquí con un namespace_id distinto al de producción (1001).
    "preprod": {
      "name": "eclipsseinorbit-preprod",
      // APP_ENV activa el X-Robots-Tag de start.ts: preproducción no debe
      // indexarse mientras se prueba Stripe. SITE_URL es la URL pública real
      // de este Worker (checkout.server.ts la exige siempre, ver CLAUDE.md).
      "vars": {
        "SITE_URL": "https://eclipsseinorbit-preprod.eclipssebrand.workers.dev",
        "APP_ENV": "preprod",
      },
      "ratelimits": [
        {
          "name": "CHECKOUT_RATE_LIMITER",
          "namespace_id": "1002",
          "simple": {
            "limit": 20,
            "period": 60,
          },
        },
      ],
    },
  },
}
