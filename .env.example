# Plantilla de variables de entorno. Copia a .env.local y rellena los valores.
# NUNCA subir .env / .env.local al repositorio (ya están en .gitignore).

# --- Stripe ---
# Clave secreta de servidor. SOLO servidor. Empieza por sk_test_ en desarrollo.
STRIPE_SECRET_KEY=

# Secreto de firma del webhook de Stripe. SOLO servidor. Empieza por whsec_
# En local se obtiene con: stripe listen --forward-to localhost:5000/api/stripe-webhook
STRIPE_WEBHOOK_SECRET=

# --- n8n (registro de pedidos) ---
# URL del webhook de n8n que recibe los pedidos pagados.
N8N_ORDER_WEBHOOK_URL=

# Secreto compartido que se envía a n8n en la cabecera X-Webhook-Secret.
# n8n debe rechazar la petición si no coincide. Genera uno largo y aleatorio.
N8N_ORDER_WEBHOOK_SECRET=

# --- Opcional ---
# URL pública del sitio (para success_url / cancel_url). Si no se define, se
# deduce del origin de la petición.
SITE_URL=
