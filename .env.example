# Plantilla de variables de entorno. Copia a .env.local y rellena los valores.
# NUNCA subir .env / .env.local al repositorio (ya están en .gitignore).

# --- Stripe (tarea siguiente: pasarela de pago) ---
# Clave secreta de servidor. SOLO servidor. Empieza por sk_test_ en desarrollo.
STRIPE_SECRET_KEY=

# Secreto de firma del webhook de Stripe. SOLO servidor. Empieza por whsec_
STRIPE_WEBHOOK_SECRET=

# Clave publicable (se expone al navegador). Empieza por pk_test_ en desarrollo.
VITE_STRIPE_PUBLISHABLE_KEY=
